<div class="home-grid">
  <section>
    <slot name="left" />
  </section>
  <section>
    <slot name="right" />
  </section>
</div>

<style>
  .home-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3rem;
    margin-top: 1rem;
  }

  .home-grid :global(h2) {
    margin-top: 0;
  }

  @media (max-width: 60rem) {
    .home-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
